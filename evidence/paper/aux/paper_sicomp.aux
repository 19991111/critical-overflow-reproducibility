\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Internal structure and restoring response, replotted from saved profile nodes and the frozen response table. Left: left and right atom probabilities at mean phases $u=0$ (solid) and $u=1/2$ (dashed). Only the displayed load levels are shown. The half-phase operation swaps the sides and shifts the new left law by one. Right: the phase-averaged response $\overline  g(d)$; positive imbalance has negative response. Connecting segments are for display. No new trajectory or numerical solution enters this figure.}}{6}{figure.19}\protected@file@percent }
\newlabel{fig:mechanism}{{3}{6}{Internal structure and restoring response, replotted from saved profile nodes and the frozen response table. Left: left and right atom probabilities at mean phases $u=0$ (solid) and $u=1/2$ (dashed). Only the displayed load levels are shown. The half-phase operation swaps the sides and shifts the new left law by one. Right: the phase-averaged response $\gb (d)$; positive imbalance has negative response. Connecting segments are for display. No new trajectory or numerical solution enters this figure}{figure.19}{}}
\newlabel{fig:mechanism@cref}{{[figure][3][]3}{[1][5][]6}{}{}{}}
