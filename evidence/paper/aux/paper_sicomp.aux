\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Different fixed cross correlations share the critical law under the model and scaling of Theorems~\ref {thm:universal}--\ref {thm:limit}. The grids show conditional candidate-pair probabilities in one cross direction, with four illustrative labels on each side. Matching probabilities are $1/4$ on the diagonal and zero elsewhere; product probabilities are all $1/16$. Both have uniform marginals. Internal sampling and rare cross arrivals are essential to the theorem; uniform marginals alone do not imply independent loads.}}{7}{figure.26}\protected@file@percent }
\newlabel{fig:kernels}{{4}{7}{Different fixed cross correlations share the critical law under the model and scaling of Theorems~\ref {thm:universal}--\ref {thm:limit}. The grids show conditional candidate-pair probabilities in one cross direction, with four illustrative labels on each side. Matching probabilities are $1/4$ on the diagonal and zero elsewhere; product probabilities are all $1/16$. Both have uniform marginals. Internal sampling and rare cross arrivals are essential to the theorem; uniform marginals alone do not imply independent loads}{figure.26}{}}
\newlabel{fig:kernels@cref}{{[figure][4][]4}{[1][7][]7}{}{}{}}
